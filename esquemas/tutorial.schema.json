{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tutorial.schema.json",
  "title": "TutorialRaiz",
  "type": "object",
  "required": ["titulo", "intro", "pasos"],
  "additionalProperties": false,
  "properties": {
    "titulo": { "$ref": "texto-bilingue.schema.json" },
    "intro": { "$ref": "texto-bilingue.schema.json" },
    "pasos": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["numero", "titulo", "texto"],
        "additionalProperties": false,
        "properties": {
          "numero": { "type": "string", "pattern": "^[0-9]{2}$" },
          "titulo": { "$ref": "texto-bilingue.schema.json" },
          "texto": { "$ref": "texto-bilingue.schema.json" }
        }
      }
    }
  }
}