{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sitio-ui.schema.json",
  "title": "TextosUiSitio",
  "type": "object",
  "required": ["ajustes", "inicio"],
  "additionalProperties": false,
  "properties": {
    "ajustes": {
      "type": "object",
      "required": [
        "titulo",
        "nombre",
        "frase",
        "acerca",
        "colores",
        "modulos",
        "moduloReuniones",
        "moduloEventos",
        "moduloRecaudacion",
        "moduloAsistente",
        "guardar",
        "volver"
      ],
      "additionalProperties": false,
      "properties": {
        "titulo": { "$ref": "texto-bilingue.schema.json" },
        "nombre": { "$ref": "texto-bilingue.schema.json" },
        "frase": { "$ref": "texto-bilingue.schema.json" },
        "acerca": { "$ref": "texto-bilingue.schema.json" },
        "colores": { "$ref": "texto-bilingue.schema.json" },
        "modulos": { "$ref": "texto-bilingue.schema.json" },
        "moduloReuniones": { "$ref": "texto-bilingue.schema.json" },
        "moduloEventos": { "$ref": "texto-bilingue.schema.json" },
        "moduloRecaudacion": { "$ref": "texto-bilingue.schema.json" },
        "moduloAsistente": { "$ref": "texto-bilingue.schema.json" },
        "guardar": { "$ref": "texto-bilingue.schema.json" },
        "volver": { "$ref": "texto-bilingue.schema.json" }
      }
    },
    "inicio": {
      "type": "object",
      "required": ["recaudacionTitulo", "recaudacionTexto", "irAjustes"],
      "additionalProperties": false,
      "properties": {
        "recaudacionTitulo": { "$ref": "texto-bilingue.schema.json" },
        "recaudacionTexto": { "$ref": "texto-bilingue.schema.json" },
        "irAjustes": { "$ref": "texto-bilingue.schema.json" }
      }
    }
  }
}