{
  "name": "@fiestapay/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sql.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/cli-migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fiestapay/shared": "*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
