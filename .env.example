NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://fiestapay:replace-with-local-password@127.0.0.1:55432/fiestapay
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Chat is OpenAI Responses only. LLM_PROVIDER=openai is accepted for compatibility; any other value is rejected.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional bounds (capped server-side): OPENAI_TIMEOUT_MS=20000 OPENAI_MAX_TOOL_ROUNDS=4 OPENAI_MAX_HISTORY=24 OPENAI_MAX_OUTPUT_TOKENS=2000
ASSEMBLYAI_API_KEY=
VOICE_ENABLED=false
VOICE_MAX_SECONDS=120
VOICE_DAILY_SECONDS=1800
